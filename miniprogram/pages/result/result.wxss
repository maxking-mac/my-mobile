/* 结果页样式 */
.page {
  background: #f0f7f0;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 评分卡片 */
.score-card {
  background: #fff;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 0;
}

/* 圆环评分 */
.score-ring-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.score-canvas {
  position: absolute;
  top: 0;
  left: 0;
}
.score-center {
  position: relative;
  z-index: 1;
  text-align: center;
  display: flex;
  align-items: baseline;
  justify-content: center;
}
.score-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #333;
  line-height: 1;
}
.score-unit {
  font-size: 24rpx;
  color: #888;
  margin-left: 4rpx;
}

/* 评分标签 */
.score-label-wrap {
  text-align: center;
  margin-bottom: 24rpx;
}
.score-label {
  display: inline-block;
  padding: 8rpx 32rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 产品信息 */
.product-info {
  text-align: center;
  margin-bottom: 24rpx;
}
.product-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 6rpx;
}
.product-brand {
  font-size: 26rpx;
  color: #888;
}

/* 统计数据 */
.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}
.stat-item {
  text-align: center;
  flex: 1;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 4rpx;
}
.stat-label {
  font-size: 22rpx;
  color: #999;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #eee;
}

/* 来源标签 */
.source-tag-row {
  text-align: center;
}
.source-tag {
  display: inline-block;
  background: #E3F2FD;
  color: #1565C0;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
}

/* 人群提醒 */
.group-alert {
  margin: 16rpx 24rpx;
  background: #FFF8E1;
  border: 1rpx solid #FFD54F;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}
.group-alert-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #E65100;
  margin-bottom: 16rpx;
}
.group-alert-item {
  margin-bottom: 12rpx;
}
.alert-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-right: 8rpx;
}
.alert-groups {
  font-size: 22rpx;
  background: #FFE082;
  color: #E65100;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 8rpx;
}
.alert-desc {
  font-size: 22rpx;
  color: #666;
  display: block;
  margin-top: 4rpx;
}

/* Tab 导航 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #888;
  font-weight: 500;
  border-bottom: 4rpx solid transparent;
}
.tab-item.active {
  color: #4CAF50;
  border-bottom-color: #4CAF50;
  font-weight: 700;
}

/* Tab 内容 */
.tab-content {
  padding: 0 24rpx;
}

/* 配料卡片 */
.ingredient-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.ingredient-main {
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 0;
}
.category-bar {
  width: 8rpx;
  min-height: 80rpx;
  align-self: stretch;
  border-radius: 0;
  flex-shrink: 0;
  margin-right: 20rpx;
}
.ingredient-body {
  flex: 1;
  padding: 20rpx 0;
}
.ingredient-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.ingredient-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}
.category-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

/* 关注等级条 */
.level-bar-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.level-bar-track {
  flex: 1;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}
.level-bar-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s;
}
.level-label {
  font-size: 22rpx;
  font-weight: 500;
  min-width: 80rpx;
  text-align: right;
}

/* 人群警告 */
.active-groups {
  margin-top: 8rpx;
}
.group-warn {
  font-size: 22rpx;
  color: #E65100;
}

/* 展开箭头 */
.expand-arrow {
  font-size: 22rpx;
  color: #ccc;
  padding: 0 8rpx;
  flex-shrink: 0;
}

/* 展开详情 */
.ingredient-detail {
  padding: 0 24rpx 20rpx 28rpx;
}
.detail-divider {
  height: 1rpx;
  background: #f5f5f5;
  margin-bottom: 16rpx;
}
.detail-desc {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 10rpx;
}
.detail-source {
  font-size: 22rpx;
  color: #2196F3;
}

/* 无高关注成分 */
.no-highlight {
  text-align: center;
  padding: 80rpx 40rpx;
}
.ok-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.ok-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #4CAF50;
  margin-bottom: 8rpx;
}
.ok-sub {
  font-size: 26rpx;
  color: #999;
}

/* 高关注卡片 */
.highlight-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  padding: 28rpx;
  border-left: 6rpx solid #F44336;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.highlight-header {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}
.highlight-level-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.highlight-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  flex: 1;
}
.highlight-level {
  font-size: 24rpx;
  font-weight: 600;
}
.highlight-category {
  margin-bottom: 14rpx;
}
.highlight-desc {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 10rpx;
}
.highlight-source {
  font-size: 22rpx;
  color: #2196F3;
  margin-bottom: 10rpx;
}
.highlight-groups {
  margin-top: 10rpx;
}
.group-label {
  font-size: 22rpx;
  color: #999;
}
.group-badge {
  display: inline-block;
  background: #FFEBEE;
  color: #C62828;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  margin-left: 8rpx;
}

/* 社区保存 */
.save-community {
  display: flex;
  align-items: center;
  margin: 16rpx 24rpx;
  background: #E3F2FD;
  border: 1rpx solid #90CAF9;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}
.save-icon {
  font-size: 44rpx;
  margin-right: 20rpx;
}
.save-info {
  flex: 1;
}
.save-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1565C0;
  margin-bottom: 4rpx;
}
.save-desc {
  font-size: 24rpx;
  color: #5C8BB5;
}
.save-btn {
  background: #2196F3;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 16rpx 28rpx;
  line-height: 1;
}
.saved-badge {
  font-size: 26rpx;
  color: #4CAF50;
  font-weight: 600;
}

/* 免责声明 */
.disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 20rpx 40rpx 10rpx;
  line-height: 1.6;
}
