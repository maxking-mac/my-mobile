/* 拍照识别页 */
.page {
  background: #f0f7f0;
  min-height: 100vh;
  padding: 32rpx;
}

/* 引导卡 */
.guide-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 48rpx 36rpx;
  text-align: center;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.07);
}
.guide-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.guide-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 16rpx;
}
.guide-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 28rpx;
}
.guide-tips {
  text-align: left;
  display: inline-block;
}
.tip-item {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 10rpx;
}

/* 按钮组 */
.btn-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.btn-camera {
  background: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.btn-album {
  background: #fff;
  color: #4CAF50;
  border: 2rpx solid #4CAF50;
  border-radius: 16rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.btn-primary {
  background: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.btn-secondary {
  background: #fff;
  color: #666;
  border: 2rpx solid #ddd;
  border-radius: 16rpx;
  padding: 30rpx;
  font-size: 30rpx;
}

/* 手动输入链接 */
.fallback-hint {
  text-align: center;
  font-size: 26rpx;
  color: #2196F3;
  padding: 16rpx;
}

/* 图片预览 */
.preview-wrap {
  background: #000;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  text-align: center;
}
.preview-image {
  width: 100%;
  max-height: 60vh;
  object-fit: contain;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 100rpx 40rpx;
}
.loading-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.loading-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}
.loading-sub {
  font-size: 26rpx;
  color: #888;
}

/* 识别结果 */
.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.result-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 8rpx;
}
.result-desc {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}
.result-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.7;
  box-sizing: border-box;
}

/* 产品名称 */
.product-name-row {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}
.name-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}
.name-input {
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #333;
  width: 100%;
  box-sizing: border-box;
}

/* 失败状态 */
.failed-state {
  text-align: center;
  padding: 80rpx 40rpx;
}
.failed-icon {
  font-size: 70rpx;
  margin-bottom: 20rpx;
}
.failed-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #F44336;
  margin-bottom: 12rpx;
}
.failed-desc {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 40rpx;
}
