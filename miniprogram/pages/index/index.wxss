/* 首页样式 */
.page {
  min-height: 100vh;
  background: #f0f7f0;
}

/* Hero区域 */
.hero {
  background: linear-gradient(135deg, #4CAF50, #2E7D32);
  padding: 60rpx 40rpx 50rpx;
  text-align: center;
  color: #fff;
}
.hero-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}
.hero-subtitle {
  font-size: 28rpx;
  opacity: 0.85;
}

/* 扫码按钮区 */
.scan-section {
  padding: 40rpx 32rpx 20rpx;
}
.scan-btn {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(76, 175, 80, 0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
  active-opacity: 0.8;
}
.scan-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.2);
}
.scan-btn-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.scan-btn-text {
  font-size: 40rpx;
  font-weight: 700;
  color: #2E7D32;
  margin-bottom: 8rpx;
}
.scan-btn-sub {
  font-size: 24rpx;
  color: #888;
}

/* 手动输入区 */
.manual-section {
  margin: 0 32rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.barcode-input {
  flex: 1;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  border: 2rpx solid #e8e8e8;
}
.search-btn {
  background: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  min-width: 120rpx;
  line-height: 1;
}

/* 演示产品 */
.demo-label {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 16rpx;
}
.demo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.demo-item {
  background: #E8F5E9;
  color: #2E7D32;
  border-radius: 20rpx;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.demo-item:active {
  background: #C8E6C9;
}

/* 功能特性 */
.features {
  margin: 0 32rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.feature-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.feature-item:last-child {
  border-bottom: none;
}
.feature-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
  width: 60rpx;
  text-align: center;
}
.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}
.feature-desc {
  font-size: 24rpx;
  color: #888;
}

/* 免责声明 */
.disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
  padding: 20rpx 40rpx 40rpx;
  line-height: 1.6;
}
