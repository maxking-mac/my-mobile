<!-- 手动输入配料页 -->
<view class="page">

  <view class="header-card">
    <view class="header-icon">✏️</view>
    <view class="header-title">手动输入配料表</view>
    <view class="header-desc">对照产品标签，输入配料表内容</view>
  </view>

  <!-- 产品名称 -->
  <view class="form-card">
    <view class="form-label">产品名称（可选）</view>
    <input
      class="form-input"
      placeholder="如：旺旺雪饼"
      value="{{productName}}"
      bindinput="onNameInput"
    />
  </view>

  <!-- 配料输入 -->
  <view class="form-card">
    <view class="form-label">
      配料表内容
      <text class="form-label-hint">（用逗号或顿号分隔）</text>
    </view>
    <textarea
      class="ingredients-textarea"
      placeholder="示例：小麦粉、白砂糖、植物油、可可粉、食用香精、碳酸氢钠"
      value="{{ingredientsText}}"
      bindinput="onIngredientInput"
      auto-height
      maxlength="2000"
    />
    <view class="char-count">{{ingredientsText.length}}/2000</view>
  </view>

  <!-- 快速示例 -->
  <view class="example-card">
    <view class="example-title">快速示例（点击使用）</view>
    <view
      class="example-item"
      wx:for="{{examples}}"
      wx:key="name"
      bindtap="useExample"
      data-text="{{item.text}}"
      data-name="{{item.name}}"
    >
      <view class="example-name">{{item.name}}</view>
      <view class="example-preview">{{item.text}}</view>
    </view>
  </view>

  <!-- 分析按钮 -->
  <view class="btn-wrap">
    <button
      class="btn-analyze {{ingredientsText.length>0?'active':''}}"
      bindtap="goAnalyze"
      disabled="{{ingredientsText.length===0}}"
    >
      🔬 开始分析配料
    </button>
  </view>

  <view class="hint">
    分析完成后可选择保存到社区数据库，帮助其他用户
  </view>
</view>
