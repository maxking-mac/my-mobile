/* 人群设置页 */
.page {
  background: #f0f7f0;
  min-height: 100vh;
  padding: 32rpx 32rpx 60rpx;
}

/* 头部 */
.page-header {
  text-align: center;
  padding: 40rpx 0 40rpx;
}
.page-header-icon {
  font-size: 70rpx;
  margin-bottom: 16rpx;
}
.page-header-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 12rpx;
}
.page-header-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 人群列表 */
.group-list {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.07);
}
.group-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.group-item:last-child {
  border-bottom: none;
}
.group-item:active {
  background: #f9f9f9;
}
.group-item.selected {
  background: #F1F8E9;
}
.group-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  width: 56rpx;
  text-align: center;
}
.group-info {
  flex: 1;
}
.group-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 4rpx;
}
.group-desc {
  font-size: 24rpx;
  color: #888;
}
.group-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
  flex-shrink: 0;
}
.group-check.checked {
  background: #4CAF50;
  border-color: #4CAF50;
}

/* 提示 */
.selected-hint {
  text-align: center;
  background: #E8F5E9;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.hint-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.hint-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #2E7D32;
  margin-bottom: 6rpx;
}
.hint-sub {
  font-size: 24rpx;
  color: #4CAF50;
}
.empty-hint {
  text-align: center;
  padding: 20rpx;
}
.hint-text-gray {
  font-size: 26rpx;
  color: #aaa;
}

/* 清除按钮 */
.btn-wrap {
  margin-bottom: 24rpx;
}
.btn-clear {
  background: #fff;
  color: #F44336;
  border: 2rpx solid #FFCDD2;
  border-radius: 16rpx;
  width: 100%;
  font-size: 28rpx;
  padding: 30rpx;
}

/* 说明 */
.notice-card {
  background: #FFF8E1;
  border: 1rpx solid #FFE082;
  border-radius: 16rpx;
  padding: 28rpx;
}
.notice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #E65100;
  margin-bottom: 12rpx;
}
.notice-text {
  font-size: 24rpx;
  color: #795548;
  line-height: 1.7;
}
