/* app.wxss */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: #333;
}

/* 通用容器 */
.container {
  padding: 20rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* 主色 */
.color-primary { color: #4CAF50; }
.color-warning { color: #FF9800; }
.color-danger  { color: #F44336; }
.color-info    { color: #2196F3; }
.color-muted   { color: #999; }

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}
.tag-green  { background: #E8F5E9; color: #388E3C; }
.tag-orange { background: #FFF3E0; color: #E65100; }
.tag-red    { background: #FFEBEE; color: #C62828; }
.tag-blue   { background: #E3F2FD; color: #1565C0; }
.tag-purple { background: #F3E5F5; color: #6A1B9A; }
.tag-gray   { background: #F5F5F5; color: #757575; }

/* 按钮 */
.btn-primary {
  background: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 48rpx;
  padding: 24rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.btn-secondary {
  background: #fff;
  color: #4CAF50;
  border: 2rpx solid #4CAF50;
  border-radius: 48rpx;
  padding: 22rpx 48rpx;
  font-size: 32rpx;
  font-weight: 500;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  color: #999;
}
.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-state .text {
  font-size: 28rpx;
}
